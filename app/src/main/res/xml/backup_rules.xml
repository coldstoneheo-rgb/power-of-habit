<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 이하 자동 백업 규칙(android:fullBackupContent).
   exclude만 두면 나머지(습관 DB · 앱 설정)는 지금처럼 백업된다(allowBackup="true" 유지 — RELEASE-PLAN §2).
   빼는 것: Google 로그인 라이브러리 저장소(play-services-base signin.internal.Storage →
   getSharedPreferences("com.google.android.gms.signin")). 로그인 계정 정보가 OS 백업으로 복사되지 않게 한다.
   같은 내용을 data_extraction_rules.xml(Android 12+)에도 둔다.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="com.google.android.gms.signin.xml" />
</full-backup-content>
